# React Bits Pro registry access. Keep the real key in .env.local only.
REACTBITS_LICENSE_KEY=

# Campbell FBLA Member Portal (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ATTENDANCE_WEBHOOK_SECRET=
# Service account shared on the Form and Sheet. Keep the private key server-only.
GOOGLE_SYNC_CLIENT_EMAIL=
GOOGLE_SYNC_PRIVATE_KEY=
# HMAC secret shared only with the installed Apps Script bridge.
GOOGLE_SYNC_WEBHOOK_SECRET=
# Optional secret used by a scheduler to reconcile missed webhooks and flush the outbox.
POINTS_SYNC_CRON_SECRET=
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_UNLOCK_SECRET=
